{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alive-bistro",
  "compatibility_date": "2026-08-06",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      // Run: wrangler d1 create alive-bistro-menu  → then paste the database_id here
      "binding": "DB",
      "database_name": "alive-bistro-menu",
      "database_id": "1272c004-748d-498e-bd71-5313b29e0941",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // Run: wrangler r2 bucket create alive-bistro-media
      "binding": "MEDIA",
      "bucket_name": "alive-bistro-media"
    }
  ]
}
