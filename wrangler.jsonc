{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alive-bistro",
  "compatibility_date": "2026-08-06",
  "pages_build_output_dir": "dist",
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://cool-glitter-1838.cloudflareaccess.com",
    "ACCESS_AUD": "860ac28860f97ab52381b44a8c59673368abe769fc53bb0ecbc5c514ce61259e"
  },
  "d1_databases": [
    {
      // Run: wrangler d1 create alive-bistro-menu  → then paste the database_id here
      "binding": "DB",
      "database_name": "alive-bistro-menu",
      "database_id": "1272c004-748d-498e-bd71-5313b29e0941",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // Run: wrangler r2 bucket create alive-bistro-media
      "binding": "MEDIA",
      "bucket_name": "alive-bistro-media"
    }
  ]
}
