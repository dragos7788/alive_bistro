# Cloudflare D1 database ID — obținut după: wrangler d1 create alive-bistro-menu
# Copiază valoarea în wrangler.jsonc → d1_databases[0].database_id
CLOUDFLARE_D1_DATABASE_ID=

# Cloudflare Account ID — găsit în dashboard.cloudflare.com → Workers & Pages
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token — pentru deploy automat din CI
# Creat în dashboard.cloudflare.com → My Profile → API Tokens → Edit Cloudflare Workers
CLOUDFLARE_API_TOKEN=
