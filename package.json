{
  "name": "alive-bistro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run images:optimize",
    "prebuild": "npm run images:optimize",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name alive-bistro",
    "images:fetch": "node scripts/fetch-menu-images.mjs",
    "images:apply": "node scripts/apply-menu-images.mjs",
    "images:optimize": "node scripts/optimize-menu-images.mjs",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "push:retention:deploy": "wrangler deploy --config wrangler.push-retention.jsonc",
    "dev:cf": "npm run build && wrangler pages dev dist",
    "dev:orders": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --compatibility-date=2026-08-06 --binding LOCAL_TEST_ORDERS=true",
    "db:migrate": "wrangler d1 migrations apply alive-bistro-menu --local",
    "db:migrate:prod": "wrangler d1 migrations apply alive-bistro-menu --remote",
    "db:seed": "node scripts/seed-menu-db.mjs && wrangler d1 execute alive-bistro-menu --local --file=scripts/seed-data.sql",
    "pretest": "npm run images:optimize",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@headlessui/react": "^2.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.5",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.6",
    "jose": "6.1.0",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.5.1",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10",
    "wrangler": "^4.35.0"
  }
}
