      "module": [
        "api/admin/categories/reorder.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/admin/items/reorder",
      "mountPath": "/api/admin/items",
      "method": "POST",
      "module": [
        "api/admin/items/reorder.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/admin/categories/:id",
